{
  "name": "foodflow",
  "version": "1.1.3",
  "private": true,
  "description": "Static 30-day meal planning app.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "verify": "node verify.js",
    "smoke:prod": "node smoke-production.js",
    "smoke:browser": "node smoke-browser.js",
    "check:runtime": "node test-runtime.js",
    "check:profiles": "node audit-all-profiles.js",
    "check:recipes": "node check-recipe-coverage.js",
    "check:refs": "node check-html-refs.js && node check-sw-files.js",
    "check:audit": "node audit.js && python validate_recipe_cleanup.py",
    "check:syntax": "node verify.js --syntax-only"
  }
}
